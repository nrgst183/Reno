// reno_vst32.exe's icon and version info (the 32-bit plug-in bridge, src/vst32). A program file that says what it is
// is less often taken for something else by virus scanners' guesswork.
IDI_ICON1 ICON "reno.ico"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reno"
            VALUE "FileDescription", "Reno 32-bit VST plug-in host"
            VALUE "FileVersion", "1.2"
            VALUE "InternalName", "reno_vst32"
            VALUE "OriginalFilename", "reno_vst32.exe"
            VALUE "ProductName", "Reno"
            VALUE "ProductVersion", "1.2"
            VALUE "LegalCopyright", "All rights reserved"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
