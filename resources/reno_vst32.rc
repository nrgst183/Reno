// reno_vst32.exe's icon and version info (the 32-bit plug-in bridge, src/vst32). A program file that says what it is
// is less often taken for something else by virus scanners' guesswork.
// The version and icon come as in reno.rc.
#include "../src/app/version.h"
#ifdef RENO_GENERATED_ICON
IDI_ICON1 ICON "icons/reno.ico"
#else
IDI_ICON1 ICON "reno.ico"
#endif

1 VERSIONINFO
FILEVERSION     RENO_VERSION_MAJOR,RENO_VERSION_MINOR,RENO_VERSION_PATCH,0
PRODUCTVERSION  RENO_VERSION_MAJOR,RENO_VERSION_MINOR,RENO_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Reno"
            VALUE "FileDescription", "Reno 32-bit VST plug-in host"
            VALUE "FileVersion", RENO_VERSION_STRING
            VALUE "InternalName", "reno_vst32"
            VALUE "OriginalFilename", "reno_vst32.exe"
            VALUE "ProductName", "Reno"
            VALUE "ProductVersion", RENO_VERSION_STRING
            VALUE "LegalCopyright", "All rights reserved"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
