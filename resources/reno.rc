// The program file's icon and version info. The version is src/app/version.h's. A CMake build draws the icon for that
// version (tools/make_logo.cpp, into icons/ in the build folder); without one, resources/reno.ico, which make_logo drew
// for the version it was last run for.
#include "../src/app/version.h"
#ifdef RENO_GENERATED_ICON
IDI_ICON1 ICON "icons/reno.ico"
#else
IDI_ICON1 ICON "reno.ico"
#endif

1 VERSIONINFO
FILEVERSION     RENO_VERSION_MAJOR,RENO_VERSION_MINOR,RENO_VERSION_PATCH,0
PRODUCTVERSION  RENO_VERSION_MAJOR,RENO_VERSION_MINOR,RENO_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Reno video editor"
            VALUE "FileVersion", RENO_VERSION_STRING
            VALUE "ProductName", "Reno"
            VALUE "ProductVersion", RENO_VERSION_STRING
            VALUE "LegalCopyright", "All rights reserved"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
