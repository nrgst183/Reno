// The program file's icon (resources/reno.ico is made by tools/make_logo.cpp from src/app/logo.cpp) and version info
IDI_ICON1 ICON "reno.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Reno video editor"
            VALUE "FileVersion", "1.0"
            VALUE "ProductName", "Reno"
            VALUE "ProductVersion", "1.0"
            VALUE "LegalCopyright", "All rights reserved"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
