# Normalise line endings: LF in the repository, with Windows-only files checked out as CRLF.
* text=auto

# Sources, scripts and docs: LF everywhere (shell scripts break with CRLF)
*.cpp   text eol=lf
*.h     text eol=lf
*.inc   text eol=lf
*.rc    text eol=lf
*.cs    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.cmake text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.supp  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Files Visual Studio and cmd.exe want with CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props   text eol=crlf
*.example text eol=crlf

# Binary files
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.wav  binary
*.sfk  binary
*.sfap0 binary
*.spv  binary
