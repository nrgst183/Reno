<?xml version="1.0" encoding="utf-8"?>
<!-- Linux: builds reno, reno_cli and the test programs in WSL with CMake (CMakePresets.json's linux-debug and
     linux-release presets) into build\linux-debug\bin or build\linux-release\bin. Pick the "Linux" platform in the
     solution's toolbar. WSL needs cmake, ninja, g++, Qt 6 and FFmpeg's development files (see README.md, "Building"). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{5928C88F-DDFC-4711-962C-323DDE74FB0A}</ProjectGuid>
    <RootNamespace>reno_linux</RootNamespace>
    <ProjectName>reno_linux</ProjectName>
    <Keyword>MakeFileProj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="Reno.props" />
  </ImportGroup>
  <PropertyGroup>
    <RenoPreset Condition="'$(Configuration)'=='Debug'">linux-debug</RenoPreset>
    <RenoPreset Condition="'$(Configuration)'!='Debug'">linux-release</RenoPreset>
    <OutDir>$(RenoRoot)build\$(RenoPreset)\bin\</OutDir>
    <NMakeBuildCommandLine>wsl.exe --cd "$(RenoRootDir)" -- bash -lc "cmake --preset $(RenoPreset) &amp;&amp; cmake --build --preset $(RenoPreset)"</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>wsl.exe --cd "$(RenoRootDir)" -- bash -lc "cmake --preset $(RenoPreset) &amp;&amp; cmake --build --preset $(RenoPreset) --clean-first"</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>wsl.exe --cd "$(RenoRootDir)" -- bash -lc "cmake --build --preset $(RenoPreset) --target clean"</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)reno</NMakeOutput>
    <NMakePreprocessorDefinitions>__linux__;__cdecl=</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(RenoRoot)third_party\openfx;$(RenoRoot)third_party\vst2;$(RenoRoot)src\ofx</NMakeIncludeSearchPath>
    <AdditionalOptions>/std:c++17</AdditionalOptions>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\CMakeLists.txt" />
    <None Include="..\CMakePresets.json" />
    <None Include="..\cmake\toolchains\windows-clangcl.cmake" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
