{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "description": "Visual Studio 2022's MSVC, Qt from C:/Qt/6.8.3/msvc2022_64, FFmpeg from vcpkg (change them in CMakeUserPresets.json)",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.8.3/msvc2022_64",
        "RENO_FFMPEG_DIR": "C:/vcpkg/installed/x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "vendor": { "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] } }
    },
    {
      "name": "windows-clangcl-release",
      "displayName": "Windows x64 Release (clang-cl)",
      "description": "The default Windows build: Visual Studio 2022's clang-cl (\"C++ Clang tools for Windows\" in the Visual Studio Installer)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "clang-cl.exe", "CMAKE_CXX_COMPILER": "clang-cl.exe" }
    },
    {
      "name": "windows-clangcl-debug",
      "displayName": "Windows x64 Debug (clang-cl)",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "clang-cl.exe", "CMAKE_CXX_COMPILER": "clang-cl.exe" }
    },
    { "name": "windows-debug",   "displayName": "Windows x64 Debug (MSVC)",   "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "windows-release", "displayName": "Windows x64 Release (MSVC)", "inherits": "windows-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },

    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "description": "Qt 6 and FFmpeg from the system (or set CMAKE_PREFIX_PATH / RENO_FFMPEG_DIR); in Visual Studio pick a WSL or SSH target",
      "cacheVariables": { "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/gcc_64" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Linux" ] },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": { "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}" }
      }
    },
    { "name": "linux-debug",         "displayName": "Linux Debug (GCC)",     "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug",   "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "linux-release",       "displayName": "Linux Release (GCC)",   "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "g++" } },
    { "name": "linux-clang-release", "displayName": "Linux Release (Clang)", "inherits": "linux-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "clang++" } },

    {
      "name": "macos-release",
      "displayName": "macOS Release (Apple Clang)",
      "description": "Qt from ~/Qt/6.8.3/macos, FFmpeg from Homebrew. Not tested yet.",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/macos" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "vendor": { "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "macOS" ] } }
    },

    {
      "name": "windows-cross",
      "displayName": "Windows x64 Release, cross-compiled from Linux (clang-cl)",
      "description": "Needs RENO_XWIN (MSVC + Windows SDK files), RENO_QT_WIN (Qt msvc2022_64), RENO_QT_HOST (the same Qt version for Linux) and RENO_FFMPEG_WIN in the environment",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clangcl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RENO_XWIN": "$env{RENO_XWIN}",
        "CMAKE_PREFIX_PATH": "$env{RENO_QT_WIN}",
        "QT_HOST_PATH": "$env{RENO_QT_HOST}",
        "RENO_FFMPEG_DIR": "$env{RENO_FFMPEG_WIN}"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "vendor": { "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Linux", "macOS" ] } }
    },
    {
      "name": "windows7-clangcl-release",
      "displayName": "Windows 7 x64 Release (clang-cl)",
      "description": "For Windows 7 and later (no Windows 8/10 functions); after building, tools/use_qt_win7.ps1 swaps Qt's DLLs for ones patched to run on Windows 7",
      "inherits": "windows-clangcl-release",
      "cacheVariables": { "RENO_WINDOWS7": "ON" }
    },
    {
      "name": "freebsd-release",
      "displayName": "FreeBSD Release (Clang)",
      "description": "Qt 6, FFmpeg and the Vulkan loader from packages (pkg install cmake ninja qt6-base qt6-multimedia ffmpeg vulkan-loader)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_PREFIX_PATH": "/usr/local/lib/qt6;/usr/local",
        "RENO_FFMPEG_DIR": "/usr/local"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "FreeBSD" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64 Release",
      "description": "Needs RENO_QT_ANDROID (Qt for Android arm64-v8a), RENO_QT_HOST (the same Qt version for this computer), ANDROID_NDK_ROOT and ANDROID_SDK_ROOT, and RENO_FFMPEG_ANDROID (FFmpeg built for Android arm64)",
      "inherits": "base",
      "toolchainFile": "$env{RENO_QT_ANDROID}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QT_HOST_PATH": "$env{RENO_QT_HOST}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "RENO_FFMPEG_DIR": "$env{RENO_FFMPEG_ANDROID}"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS (Xcode project)",
      "description": "On a Mac with Xcode: needs RENO_QT_IOS (Qt for iOS), RENO_QT_HOST (Qt for macOS of the same version) and RENO_FFMPEG_IOS (FFmpeg built for iOS as static libraries); for iOS 16 and later; sign and run from the Xcode project made in build/ios",
      "inherits": "base",
      "generator": "Xcode",
      "toolchainFile": "$env{RENO_QT_IOS}/lib/cmake/Qt6/qt.toolchain.cmake",
      "cacheVariables": { "QT_HOST_PATH": "$env{RENO_QT_HOST}", "RENO_FFMPEG_DIR": "$env{RENO_FFMPEG_IOS}", "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-clangcl-release", "configurePreset": "windows-clangcl-release" },
    { "name": "windows-clangcl-debug",   "configurePreset": "windows-clangcl-debug" },
    { "name": "windows-debug",           "configurePreset": "windows-debug" },
    { "name": "windows-release",         "configurePreset": "windows-release" },
    { "name": "linux-debug",             "configurePreset": "linux-debug" },
    { "name": "linux-release",           "configurePreset": "linux-release" },
    { "name": "linux-clang-release",     "configurePreset": "linux-clang-release" },
    { "name": "macos-release",           "configurePreset": "macos-release" },
    { "name": "windows-cross",           "configurePreset": "windows-cross" },
    { "name": "windows7-clangcl-release", "configurePreset": "windows7-clangcl-release" },
    { "name": "freebsd-release",         "configurePreset": "freebsd-release" },
    { "name": "android-arm64",           "configurePreset": "android-arm64" },
    { "name": "ios",                     "configurePreset": "ios", "configuration": "Release" }
  ]
}
